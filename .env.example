# Configuração de Conexão com o Banco de Dados Neon (PostgreSQL)
# Obtenha sua Connection String no Dashboard do Neon (https://console.neon.tech)
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# Chave Secreta para Operações Administrativas (DELETE, PUT, PATCH e /api/audit)
ADMIN_KEY=admin123
